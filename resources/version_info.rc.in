#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @KR_FILE_VERSION_COMMAS@
 PRODUCTVERSION @KR_FILE_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Perpetus"
            VALUE "FileDescription", "@KR_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@KR_PRODUCT_VERSION@"
            VALUE "InternalName", "@KR_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (C) @KR_COPYRIGHT_YEAR@ Perpetus."
            VALUE "OriginalFilename", "@KR_ORIGINAL_FILENAME@"
            VALUE "ProductName", "Krypton"
            VALUE "ProductVersion", "@KR_PRODUCT_VERSION@"
            VALUE "Comments", "@KR_FILE_COMMENTS@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
